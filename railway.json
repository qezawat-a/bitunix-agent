{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -e ."
  },
  "deploy": {
    "startCommand": ".venv/bin/python -m jrock.main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}