# J+ROCK Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your API keys.

# ── Bitunix API ──────────────────────────────────────────────────────────────
BITUNIX_API_KEY=your_bitunix_api_key_here
BITUNIX_SECRET_KEY=your_bitunix_secret_key_here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint (leave LLM_BASE_URL empty for Anthropic default)
LLM_BASE_URL=
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=
LLM_PROVIDER=openai   # openai | anthropic

# AutoSetModelByKey aliases (scanned on boot in addition to LLM_BASE_URL/LLM_API_KEY).
# The agent pings these endpoints and auto-switches to any model that works with your key.
BASE_URL=
API_KEY=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to control the agent
TELEGRAM_ALLOWED_USERS=123456789

# ── Agent ────────────────────────────────────────────────────────────────────
# Directory for persistent state (journal, memory, settings)
JRROCK_STATE_DIR=./state

# ── Git Push Automation ──────────────────────────────────────────────────────
# Force-push verified code assets to GitHub via /git_push.
# GITHUB_PAT: Personal Access Token with repo scope
# GITHUB_REPO: full repo link, e.g. https://github.com/owner/repo.git
GITHUB_PAT=your_github_pat_here
GITHUB_REPO=your_github_repo_link_here
# Git author identity for the auto-commit (optional)
GIT_AUTHOR_NAME=J+ROCK
GIT_AUTHOR_EMAIL=jrock@localhost
